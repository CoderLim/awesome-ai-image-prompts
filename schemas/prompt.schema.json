{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "category",
    "inputMode",
    "status",
    "prompt",
    "media",
    "sourcePreview",
    "provenance",
    "rights"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "object"
    },
    "type": {
      "enum": [
        "generation",
        "editing",
        "unclassified"
      ]
    },
    "category": {
      "type": "string"
    },
    "inputMode": {
      "enum": [
        "text-to-image",
        "reference-to-image",
        "image-editing",
        "unknown"
      ]
    },
    "status": {
      "const": "index-only"
    },
    "prompt": {
      "type": "null"
    },
    "media": {
      "type": "array",
      "maxItems": 0
    },
    "sourcePreview": {
      "type": "object",
      "required": [
        "images",
        "promptExcerpt",
        "excerptTruncated"
      ],
      "properties": {
        "images": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "url",
              "role"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "role": {
                "enum": [
                  "source-media",
                  "input",
                  "output"
                ]
              }
            }
          }
        },
        "promptExcerpt": {
          "type": "string",
          "maxLength": 100
        },
        "excerptTruncated": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "originalSource",
        "collectedFrom"
      ]
    },
    "rights": {
      "type": "object",
      "required": [
        "prompt",
        "media"
      ]
    }
  }
}
